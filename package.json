{
  "name": "@ankhorage/flow",
  "version": "0.6.1",
  "description": "Standalone workflow engine foundation for Ankhorage.",
  "keywords": [
    "ankhorage",
    "flow",
    "workflow",
    "automation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./execution": {
      "types": "./dist/execution.d.ts",
      "default": "./dist/execution.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./social": {
      "types": "./dist/social.d.ts",
      "default": "./dist/social.js"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/flow.git"
  },
  "bugs": {
    "url": "https://github.com/ankhorage/flow/issues"
  },
  "homepage": "https://github.com/ankhorage/flow#readme",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "serve": "bun src/cli/standalone.ts",
    "test": "bun test src test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node-esm.json && tsc --noEmit -p tsconfig.test.json",
    "version-packages": "ankhorage-changeset version"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.4.3",
    "@ankhorage/paradox": "^0.3.6",
    "@ankhorage/secrets-supabase-vault": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@ankhorage/ankh": "^0.13.5",
    "@ankhorage/contracts": "^26.7.0"
  },
  "ankh": {
    "category": "flow",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      {
        "id": "flow.serve",
        "owner": "@ankhorage/flow",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Start Flow server",
        "description": "Start an authenticated standalone Flow workflow server."
      }
    ]
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  }
}
